# ── server ────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── auth ──────────────────────────────────────────────────────────────────
# REQUIRED. Master API key that clients must send as X-Api-Key.
# Generate with: openssl rand -base64 48
# Anyone with this key has full access — treat like an admin password.
AGENTS_MANAGER_API_KEY=

# ── database ──────────────────────────────────────────────────────────────
# SQLite path. Will be created if missing.
DATABASE_URL=sqlite:///data/app.db

# ── storage ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/data/blobs
# S3-compatible (not yet implemented):
# STORAGE_S3_BUCKET=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=

# ── limits ────────────────────────────────────────────────────────────────
MAX_BLOB_BYTES=104857600   # 100 MB

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins for browser clients. Defaults to permissive.
# Electron clients don't need CORS, but the header allow-list still applies.
# CORS_ORIGIN=https://your-frontend.example

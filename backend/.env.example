# ── server ────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 64
JWT_SECRET=change-me

# Allow new user registration after the admin account is set up.
# First account is auto-admin; further registrations need this set to true.
ALLOW_REGISTRATION=false

# ── database ──────────────────────────────────────────────────────────────
# SQLite path. Will be created if missing.
DATABASE_URL=sqlite:///data/app.db

# ── storage ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/data/blobs
# S3-compatible (not yet implemented in v0.1):
# STORAGE_S3_BUCKET=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=

# ── limits ────────────────────────────────────────────────────────────────
MAX_BLOB_BYTES=104857600   # 100 MB

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins for browser clients. Defaults to permissive — if you
# expose this server on the public internet, restrict it. Electron clients
# don't need CORS.
# CORS_ORIGIN=https://your-frontend.example
